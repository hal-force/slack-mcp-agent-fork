# VHA demo — red-team injection fixture must NEVER be committed (planted prompt-injection)
demo-data/vha/vha_redteam_injection.csv

# VHA demo — Prep build artifacts (Hyper extracts, logs, run outputs); not needed at runtime
demo-data/vha/.prep-run/
demo-data/vha/prep-flow/
demo-data/vha/**/*.hyper
demo-data/vha/*.log
.secrets-scratch/

# SCRM / ARMOR demos — red-team injection fixtures must NEVER be committed (same rule as VHA;
# each generate.js recreates them deterministically for local injection-fencing tests)
demo-data/scrm/scrm_redteam_injection.csv
demo-data/armor/armor_redteam_injection.csv

