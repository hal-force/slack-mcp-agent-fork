    "@google/genai": "^1.52.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.15.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.2.0"
