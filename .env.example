# Slack (required for OAuth and events)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# Install store: Postgres (Heroku sets DATABASE_URL automatically)
# Local: postgres://user:password@localhost:5432/slack-mcp-agent
DATABASE_URL=


# Google Cloud / Vertex AI (for Gemini)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Optional: path to service account JSON; omit to use ADC (e.g. gcloud auth)
# GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-pro
TABLEAU_MCP_SERVER=

# Server
PORT=3000
SLACK_CONTEXT_DEBUG=1
SLACK_LOG_LEVEL=debug
TABLEAU_MCP_LIST_DATASOURCES=1
TABLEAU_MCP_DATASOURCE_LIST_LIMIT=200

PUBLIC_BASE_URL=  #<--put the ngrok url here. for example: https://82a4-202-120-244-176.ngrok-free.app

# Scopes: use SLACK_BOT_SCOPES + SLACK_USER_SCOPES (app uses these when set). Do not use generic "search:read" — use search:read.public, search:read.private, etc.
# SLACK_SCOPES=...

SLACK_BOT_SCOPES=actions:write,chat:write,mpim:write,search:read.public,users:read,users:read.email,assistant:write,app_mentions:read,im:history
SLACK_USER_SCOPES=im:read,canvases:read,canvases:write,channels:history,channels:read,channels:write,chat:write,groups:history,groups:read,im:history,mpim:history,search:read,search:read.files,search:read.im,search:read.mpim,search:read.private,search:read.public,search:read.users,users:read,users:read.email
