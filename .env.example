# slack-mcp-agent — environment variable reference
#
# Copy to `.env` for local dev (dotenv loads it), or use as the authoritative
# list of what to set in your deployment's config store (Heroku config vars,
# AWS Secrets Manager, etc.). On AWS the Terraform in deploy/aws/terraform wires
# these for you — this file is the human-readable index of the same surface.
#
# ✱ = SECRET (store in a secrets manager; never commit a filled-in .env).
# Required to boot are marked [required]; the rest have safe defaults or enable
# optional features. The deploy gate (`npm run health:configcheck`) enforces the
# required set and warns on risky-but-optional gaps.

# ─── Slack (OAuth receiver) ────────────────────────────────────────────────
SLACK_SIGNING_SECRET=            # ✱ [required] Slack app signing secret
SLACK_CLIENT_ID=                 # ✱ [required] OAuth client id
SLACK_CLIENT_SECRET=             # ✱ [required] OAuth client secret
SLACK_STATE_SECRET=              # ✱ [required] signs OAuth state param
# The install flow requests THESE scopes (not the manifest's). A missing scope
# here (e.g. im:write) silently breaks the corresponding feature.
SLACK_BOT_SCOPES=im:write,chat:write,app_mentions:read,channels:history,groups:history,mpim:write,commands,canvases:write,files:write,users:read
SLACK_USER_SCOPES=               # optional user-token scopes (channel history as the user)
PUBLIC_BASE_URL=                 # https://<host> — enables the "add to Slack" install link
SLACK_TEAM_ID=                   # workspace id; needed by scheduled/broadcast jobs
SLACK_APP_DISPLAY_NAME=          # optional; used in reinstall prompts
SLACK_LOG_LEVEL=                 # debug|info|warn|error (defaults by NODE_ENV)
SLACK_MAX_CHANNEL_MESSAGES=      # optional cap on channel history fetch
SLACK_CONTEXT_DEBUG=             # =1 verbose install/context logging
SLACK_MCP_DEBUG=                 # =1 verbose MCP logging

# ─── Database (Postgres / Aurora) ──────────────────────────────────────────
DATABASE_URL=                    # ✱ [required] postgresql://user:pass@host:5432/db
# TLS: production verifies the RDS CA (recommended); demo tier may skip it.
PGSSLROOTCERT=certs/rds-global-bundle.pem   # CA bundle for strict RDS/Aurora verify
# DATABASE_SSL_CA_FILE=          # alternative CA path
# DATABASE_SSL_NO_VERIFY=1       # demo-only escape hatch: encrypt but don't verify issuer

# ─── Token encryption at rest ──────────────────────────────────────────────
TOKEN_ENC_KEY=                   # ✱ 32-byte key (base64/hex/raw). Unset = tokens stored PLAINTEXT (warns)

# ─── LLM provider (pick one via AI_PROVIDER) ───────────────────────────────
AI_PROVIDER=bedrock              # bedrock | gateway | vertex (default: vertex)
# Bedrock:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=                  # or AWS_REGION / AWS_DEFAULT_REGION
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=        # ✱ optional long-term key; OMIT on AWS to use the IAM instance role
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN  # ✱ SigV4 alternative
BEDROCK_MAX_TOOL_ROUNDS=         # default 10
# Gateway (OpenAI-compatible):
LLM_GATEWAY_URL=                 # https://.../v1/chat/completions
LLM_GATEWAY_API_KEY=             # ✱
LLM_GATEWAY_MODEL=
LLM_GATEWAY_TIMEOUT_MS=          # default 60000
# Vertex/Gemini:
GOOGLE_CLOUD_PROJECT=
GCP_SERVICE_ACCOUNT_JSON=        # ✱ full SA JSON (written to a 0600 temp file at boot)
VERTEX_LOCATION=                 # default us-central1
GEMINI_MODEL=
GEMINI_FAST_MODEL=
# Shared:
LLM_MAX_OUTPUT_TOKENS=           # default 4096

# ─── Tableau MCP server ────────────────────────────────────────────────────
TABLEAU_MCP_SERVER=              # https://<mcp-host>/tableau-mcp (deployment default)
TABLEAU_MCP_ALLOW_PRIVATE=       # =1 allow a private/VPC MCP host (AWS private-ingress setup)
TABLEAU_MCP_DATASOURCE_LIST_LIMIT=   # default 50
TABLEAU_MCP_QUERY_TOOLS=         # =0 disables live query tools
# TABLEAU_MCP_LIST_DATASOURCES / _VERBOSE_TOOLS / _QUERY_CONTRACT / _MAX_RESULT_CHARS ...
TABLEAU_DATASOURCE_BROWSE_URL_TEMPLATE=   # site-specific …/{luid} deep-link pattern

# ─── Webhooks & scheduled jobs ─────────────────────────────────────────────
TABLEAU_WEBHOOK_SECRET=          # ✱ path secret for POST /webhooks/tableau/refresh/<secret>
VHA_DAILY_JOB_SECRET=            # ✱ path secret for POST /jobs/vha-daily/<secret> (EventBridge trigger)

# ─── VHA localized brief (proactive brief workload) ────────────────────────
VHA_BRIEF_BINDINGS=              # JSON: pin email/slackId → facility+role
VHA_BRIEF_DATA_DIR=              # default demo-data/vha
BRIEF_HOUR_LOCAL=7               # local send-hour gate
VHA_BRIEF_MAX_METRICS=5
VHA_BRIEF_IGNORE_HOUR=           # =1 ignore the hour gate (used by --daily)
VHA_BRIEF_DRY_RUN=               # =1 compute but don't send
# VHA_BRIEF_USERS / VHA_BRIEF_USE_ROSTER / VHA_DIGEST_* (localized digest job)

# ─── Multi-agent (experimental) ────────────────────────────────────────────
AGENTS_ENABLED=                  # =1 enable the supervisor+specialist layer (default off = single-call baseline)
# AGENT_TRIAGE_MODEL_ID=         # pin the triage specialist to a fixed Bedrock model (reproducible eval scores)

# ─── Runtime ───────────────────────────────────────────────────────────────
PORT=3000                        # set by the platform (Heroku/App Runner)
NODE_ENV=production
