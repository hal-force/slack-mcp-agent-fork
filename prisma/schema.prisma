generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Installation {
  id            String   @id
  enterpriseId  String?
  teamId        String?
  userId        String?  // for per-user tokens: E:enterpriseId:userId or T:teamId:userId
  botToken      String
  userToken     String?  // xoxp- user token when user scopes are requested
  botId         String?
  botUserId     String?
  installerUser String?
  scope         String?  // bot scopes (comma-separated)
  userScope     String?  // user scopes (comma-separated)
  appId         String?
  tokenType     String?  @default("bot")
  installedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enterpriseId])
  @@index([teamId])
  @@index([userId])
}